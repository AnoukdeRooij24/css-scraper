{
  "source": ["src/**/*.tokens.json"],
  "preprocessors": ["tokens-studio"],
  "log": {
    "verbosity": "verbose"
  },
  "platforms": {
    "css": {
      "transformGroups": "tokens-studio",
      "transforms": ["name/kebab"],
      "buildPath": "dist/",
      "files": [
        {
          "destination": "theme.css",
          "format": "css/variables",
          "options": {
            "selector": ".fdnd-theme",
            "outputReferences": true
          }
        },
        {
          "destination": "variables.css",
          "format": "css/variables",
          "options": {
            "selector": ":root",
            "outputReferences": true
          }
        }
      ]
    }
  }
}
