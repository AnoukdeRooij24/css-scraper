#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/Users/anouk/Sites/stage-anouk/node_modules/.pnpm/style-dictionary@5.3.3_tslib@2.8.1/node_modules/style-dictionary/node_modules:/Users/anouk/Sites/stage-anouk/node_modules/.pnpm/style-dictionary@5.3.3_tslib@2.8.1/node_modules:/Users/anouk/Sites/stage-anouk/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/Users/anouk/Sites/stage-anouk/node_modules/.pnpm/style-dictionary@5.3.3_tslib@2.8.1/node_modules/style-dictionary/node_modules:/Users/anouk/Sites/stage-anouk/node_modules/.pnpm/style-dictionary@5.3.3_tslib@2.8.1/node_modules:/Users/anouk/Sites/stage-anouk/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../.pnpm/style-dictionary@5.3.3_tslib@2.8.1/node_modules/style-dictionary/bin/style-dictionary.js" "$@"
else
  exec node  "$basedir/../.pnpm/style-dictionary@5.3.3_tslib@2.8.1/node_modules/style-dictionary/bin/style-dictionary.js" "$@"
fi
